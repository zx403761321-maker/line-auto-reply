# ─── 密钥和敏感配置 ───
.env
*.key
*_secret*
config/bridge_token

# ─── 每台服务器各自维护的本地配置 ───
config/devices.yaml
config/personas.yaml
config/settings.yaml
config/accounts.yaml
config/devices.json
config/monitor.yaml
config/greetings.txt

# ─── 生成物（由 make deploy 从 template.sh 生成，不入库） ───
scripts/daily_add_cloud-*.sh

# ─── 客户数据（绝不能提交） ───
data/state/
data/leads/
data/targets/
data/*.json
data/*.txt
data/*.db*
!data/README.md

# ─── 日志 ───
logs/
*.log

# ─── 日报（每台服务器各自运行） ───
reports/

# ─── 运行时数据 ───
__pycache__/
*.pyc
*.pyo
.DS_Store
Thumbs.db

# ─── IDE ───
.idea/
.vscode/

# ─── 本地遗留副本（历史备份，不入库） ───
line-crm/

# ─── 证书 ───
caddy/certs/
*.so
*.so.0
services/adb-bridge/adb
services/adb-bridge/adb-host
services/adb-bridge/adb-libs*
